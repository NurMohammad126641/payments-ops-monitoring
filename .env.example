# Copy to .env and fill in. .env is git-ignored; never commit real values.

# One variable per data source in config/monitors.yaml.
# The value below matches the local demo database from docker-compose.yml.
PAYMENTS_DB_URL=postgresql://opsmon:opsmon@localhost:5432/payments

# Google Sheets sink (only needed for `opsmon run --sink sheets`).
# Share the spreadsheet with the service account's email address.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=secrets/service-account.json

# Email alerts (leave SMTP_HOST empty to disable).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Microsoft Teams incoming webhook (leave empty to disable).
TEAMS_WEBHOOK_URL=

LOG_LEVEL=INFO
